{
  "manifest_version": "0.2",
  "name": "obscura-mcp",
  "version": "0.1.0",
  "description": "Add your description here",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/obscura_mcp/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","obscura_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "obscura-mcp", "description": "Add your description here" }
  ]
}
